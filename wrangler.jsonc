{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truer-coach",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/demo/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pt-coach",
      "database_id": "193b6082-5240-40d7-8062-0d617d8f7643",
      "migrations_dir": "migrations"
    }
  ],
  // Photos and videos. To use R2 instead (needs a card on file), add an r2_buckets entry with binding "MEDIA".
  "kv_namespaces": [
    { "binding": "MEDIA_KV", "id": "88fe189ecc544c19a1f12bb0c716375b" }
  ],
  "vars": {
    // Set to a non-empty value to require a code when a therapist signs up.
    "SIGNUP_CODE": "",
    // "true" enables /demo/coach and /demo/client links with seeded sample data.
    "DEMO_MODE": "true"
  }
}
